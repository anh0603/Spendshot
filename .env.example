# SpendShot Environment Variables
# Copy to .env and fill secrets — NEVER hardcode

# Backend
DATABASE_URL=sqlite:///./spendshot.db
# For production: DATABASE_URL=postgresql://user:pass@localhost:5432/spendshot
JWT_SECRET=change-me-generate-strong-random-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# PWA Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@spendshot.local

# Test/dev: false (cho lưu không cần ảnh). Production: đặt true (bắt buộc chụp/upload ảnh).
REQUIRE_PHOTO=false

APP_ENV=development
FRONTEND_URL=http://localhost:5173
# Seed Super Admin (KHÔNG điền password thật vào file này)
ADMIN_EMAIL=
ADMIN_PASSWORD=
PUSH_SCHEDULE=08:00,10:00,12:00,15:00,18:00,20:00
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
RESEND_API_KEY=
EMAIL_FROM=SpendShot <nhac@spendshot.local>
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
NOTIFICATION_HISTORY_RETENTION_DAYS=90
CRON_SECRET=
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=spendshot
# Admin Storage quota (bytes, trống = không rõ; local fallback disk). Không hard-code vào logic.
# STORAGE_LIMIT_BYTES=10737418240
STORAGE_WARN_THRESHOLD=80
STORAGE_CRITICAL_THRESHOLD=90

# Frontend
VITE_API_URL=http://localhost:8000
# Production: đặt true cùng REQUIRE_PHOTO backend
VITE_REQUIRE_PHOTO=false
