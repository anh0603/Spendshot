DATABASE_URL=sqlite:///./spendshot.db
JWT_SECRET=change-me-generate-strong-random-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@spendshot.local
# Test/dev: false (cho lưu không cần ảnh). Production: đặt true (bắt buộc chụp/upload ảnh).
REQUIRE_PHOTO=false

APP_ENV=development
FRONTEND_URL=http://localhost:5173
# Seed Super Admin (KHÔNG điền password thật vào file này)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# CORS whitelist bổ sung (phân tách dấu phẩy). Production khai báo domain thật, không dùng "*".
# CORS_EXTRA_ORIGINS=https://app.example.com,https://admin.example.com

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@spendshot.local

PUSH_SCHEDULE=08:00,10:00,12:00,15:00,18:00,20:00
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

RESEND_API_KEY=
EMAIL_FROM=SpendShot <nhac@spendshot.local>
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
NOTIFICATION_HISTORY_RETENTION_DAYS=90

# Secret cho POST /internal/cron (cron-job.org gửi kèm header X-Cron-Secret).
CRON_SECRET=

# Storage: local (dev) | supabase (production, Supabase Storage bucket PRIVATE).
# Frontend KHÔNG gọi Supabase trực tiếp — đọc ảnh qua backend proxy /sb/*.
# Chỉ backend dùng SERVICE_ROLE_KEY. Không commit key thật.
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=spendshot
# Admin Storage quota: giới hạn bytes tự cấu hình (trống = không rõ, local fallback disk).
# Không hard-code 10GB vào logic. Trạng thái: <warn NORMAL, >=warn WARNING, >=critical CRITICAL.
# STORAGE_LIMIT_BYTES=10737418240
STORAGE_WARN_THRESHOLD=80
STORAGE_CRITICAL_THRESHOLD=90
